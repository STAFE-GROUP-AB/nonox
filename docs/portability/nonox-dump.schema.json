{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nonox.app/schema/nonox-dump-1.json",
  "title": "NONOX company dump",
  "description": "Full-company export, accounting core (schema 1.0.0). Money is integer ore. Dates are YYYY-MM-DD. posted_at is YYYY-MM-DD HH:MM:SS in Europe/Stockholm. Ids are the source installation's ids and are remapped on import (ADR-065).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "generated_at", "includes_personal_numbers", "company", "fiscal_years", "voucher_number_counters", "accounts", "cost_centers", "projects", "voucher_series", "vouchers", "customers", "suppliers", "counts"],
  "properties": {
    "format": {"const": "nonox-dump"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+"},
    "includes_personal_numbers": {"type": "boolean"},
    "company": {"$ref": "#/$defs/company"},
    "fiscal_years": {"type": "array", "items": {"$ref": "#/$defs/fiscalYear"}},
    "voucher_number_counters": {"type": "array", "items": {"$ref": "#/$defs/counter"}},
    "accounts": {"type": "array", "items": {"$ref": "#/$defs/account"}},
    "cost_centers": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
    "voucher_series": {"type": "array", "items": {"$ref": "#/$defs/series"}},
    "vouchers": {"type": "array", "items": {"$ref": "#/$defs/voucher"}},
    "customers": {"type": "array", "items": {"$ref": "#/$defs/customer"}},
    "suppliers": {"type": "array", "items": {"$ref": "#/$defs/supplier"}},
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "org_number", "legal_form", "legal_name", "country", "fiscal_year_start_month", "accounting_method", "vat_period", "vat_registered", "reporting_framework", "base_currency"],
      "properties": {
        "source_id": {"type": "integer"},
        "name": {"type": "string"},
        "org_number": {"type": ["string", "null"]},
        "legal_form": {"type": ["string", "null"]},
        "legal_name": {"type": ["string", "null"]},
        "vat_number": {"type": ["string", "null"]},
        "address_line1": {"type": ["string", "null"]},
        "address_line2": {"type": ["string", "null"]},
        "postal_code": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "country": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]},
        "phone": {"type": ["string", "null"]},
        "website": {"type": ["string", "null"]},
        "fiscal_year_start_month": {"type": ["integer", "null"]},
        "accounting_method": {"type": ["string", "null"]},
        "vat_period": {"type": ["string", "null"]},
        "vat_registered": {"type": ["boolean", "null"]},
        "reporting_framework": {"type": ["string", "null"]},
        "bas_version": {"type": ["string", "null"]},
        "f_skatt": {"type": ["boolean", "null"]},
        "employer_registered": {"type": ["boolean", "null"]},
        "base_currency": {"type": ["string", "null"]},
        "bankgiro": {"type": ["string", "null"]},
        "plusgiro": {"type": ["string", "null"]},
        "iban": {"type": ["string", "null"]},
        "bic": {"type": ["string", "null"]},
        "locked_until_date": {"type": ["string", "null"]},
        "archived_at": {"type": ["string", "null"]}
      }
    },
    "fiscalYear": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_date", "end_date", "status", "ledger_head_hash"],
      "properties": {
        "id": {"type": "integer"},
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "status": {"enum": ["OPEN", "CLOSED"]},
        "closed_at": {"type": ["string", "null"]},
        "closed_by": {"type": ["integer", "null"]},
        "ledger_head_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reporting_framework": {"enum": ["K1", "K2", "K3"]},
        "reporting_framework_changed_at": {"type": ["string", "null"]},
        "reporting_framework_changed_by": {"type": ["integer", "null"]},
        "reporting_framework_change_reason": {"type": ["string", "null"]}
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fiscal_year_id", "series_id", "next_number"],
      "properties": {
        "fiscal_year_id": {"type": "integer"},
        "series_id": {"type": "integer"},
        "next_number": {"type": "integer", "minimum": 1}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "name", "type", "is_active"],
      "properties": {
        "id": {"type": "integer"},
        "number": {"type": "integer", "minimum": 1000, "maximum": 9999},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "sru_code": {"type": ["string", "null"]},
        "is_active": {"type": "boolean"},
        "requires_cost_center": {"type": "boolean"},
        "requires_project": {"type": "boolean"},
        "vat_box": {"type": ["integer", "null"]}
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "is_active"],
      "properties": {
        "id": {"type": "integer"},
        "code": {"type": "string"},
        "name": {"type": "string"},
        "is_active": {"type": "boolean"}
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "is_default"],
      "properties": {
        "id": {"type": "integer"},
        "code": {"type": "string"},
        "name": {"type": "string"},
        "is_default": {"type": "boolean"}
      }
    },
    "voucher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fiscal_year_id", "series_id", "series", "number", "status", "voucher_date", "description", "source", "posted_at", "hash", "previous_hash", "rows", "attachments"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "fiscal_year_id": {"type": "integer"},
        "series_id": {"type": "integer"},
        "series": {"type": "string"},
        "number": {"type": ["integer", "null"]},
        "status": {"enum": ["DRAFT", "POSTED"]},
        "voucher_date": {"$ref": "#/$defs/date"},
        "description": {"type": "string"},
        "source": {"type": "string"},
        "source_type": {"type": ["string", "null"]},
        "source_id": {"type": ["string", "null"]},
        "corrects_voucher_id": {"type": ["string", "null"]},
        "corrected_by_voucher_id": {"type": ["string", "null"]},
        "posted_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"},
        "posted_by": {"type": ["integer", "null"]},
        "created_by": {"type": ["integer", "null"]},
        "hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "previous_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
        "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "account_id", "account", "debit_ore", "credit_ore", "description", "cost_center_id", "project_id", "quantity"],
      "properties": {
        "id": {"type": "integer"},
        "account_id": {"type": "integer"},
        "account": {"type": "integer"},
        "debit_ore": {"type": "integer", "minimum": 0},
        "credit_ore": {"type": "integer", "minimum": 0},
        "description": {"type": ["string", "null"]},
        "cost_center_id": {"type": ["integer", "null"]},
        "project_id": {"type": ["integer", "null"]},
        "quantity": {"type": ["string", "null"]}
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "original_name", "mime", "size", "sha256", "file"],
      "properties": {
        "id": {"type": "integer"},
        "original_name": {"type": "string"},
        "mime": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "uploaded_by": {"type": ["integer", "null"]},
        "file": {"type": ["string", "null"], "description": "Path inside the package, attachments/<sha256>, or null when the file was missing or damaged at export (see the export warnings)."}
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "name", "is_active", "country", "currency"],
      "properties": {
        "id": {"type": "integer"},
        "number": {"type": "integer"},
        "name": {"type": "string"},
        "org_number": {"type": ["string", "null"]},
        "personal_number": {"type": ["string", "null"], "description": "Present only when includes_personal_numbers is true (decrypted; the package itself is encrypted)."},
        "vat_number": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]},
        "phone": {"type": ["string", "null"]},
        "address_line1": {"type": ["string", "null"]},
        "address_line2": {"type": ["string", "null"]},
        "postal_code": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "country": {"type": "string"},
        "payment_terms_days": {"type": ["integer", "null"]},
        "is_active": {"type": "boolean"},
        "reverse_charge_construction": {"type": ["boolean", "null"]},
        "foreign_sale": {"type": ["string", "null"]},
        "processing_restricted_at": {"type": ["string", "null"]},
        "currency": {"type": "string"},
        "peppol_id": {"type": ["string", "null"]},
        "invoice_delivery": {"type": ["string", "null"]}
      }
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "name", "is_active", "country"],
      "properties": {
        "id": {"type": "integer"},
        "number": {"type": "integer"},
        "name": {"type": "string"},
        "org_number": {"type": ["string", "null"]},
        "vat_number": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]},
        "phone": {"type": ["string", "null"]},
        "address_line1": {"type": ["string", "null"]},
        "postal_code": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "country": {"type": "string"},
        "bankgiro": {"type": ["string", "null"]},
        "plusgiro": {"type": ["string", "null"]},
        "iban": {"type": ["string", "null"]},
        "bic": {"type": ["string", "null"]},
        "payment_terms_days": {"type": ["integer", "null"]},
        "default_account_id": {"type": ["integer", "null"]},
        "is_active": {"type": "boolean"},
        "processing_restricted_at": {"type": ["string", "null"]},
        "payment_code": {"type": ["string", "null"]}
      }
    }
  }
}
