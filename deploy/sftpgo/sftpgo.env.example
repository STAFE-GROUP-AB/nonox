# /etc/sftpgo/sftpgo.env — read by the systemd unit (EnvironmentFile).
# Owner root, group sftpgo, mode 0640. Never commit the real file.
#
# The shared secret NONOX checks on every hook call. The same value goes in
# NONOX's .env as NONOX_SFTPGO_HOOK_SECRET. At least 32 characters, e.g.:
#   openssl rand -hex 32
# SFTPGo sends it as "Authorization: Bearer <secret>", and only to URLs that
# start with the given prefix (SFTPGo's http.headers setting; overridden from
# the environment with SFTPGO_ + the key path, "__" between levels, list
# items by number — docs.sftpgo.com/latest/env-vars/).
SFTPGO_HTTP__HEADERS__0__KEY=Authorization
SFTPGO_HTTP__HEADERS__0__VALUE="Bearer CHANGE-ME-openssl-rand-hex-32"
SFTPGO_HTTP__HEADERS__0__URL=https://nonox.example.se/hooks/sftpgo/

# Where SFTPGo keeps its own state (not the uploaded files).
SFTPGO_DATA_PROVIDER__NAME=/var/lib/sftpgo/sftpgo.db
