{
    "name": "stafe-group-ab/nonox",
    "type": "project",
    "description": "NONOX Ekonomisystem - open source Swedish bookkeeping and finance system",
    "keywords": [
        "laravel",
        "framework",
        "accounting",
        "swedish",
        "bokföring"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "brick/math": "^1.0",
        "dompdf/dompdf": "^3.1",
        "laravel/ai": "^1.2",
        "laravel/framework": "^13.0",
        "laravel/jetstream": "^5.5",
        "laravel/mcp": "^1.1",
        "laravel/passkeys": "^0.2",
        "laravel/passport": "^13.10",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.0",
        "picqer/php-barcode-generator": "^3.3",
        "smalot/pdfparser": "^2.13",
        "symfony/yaml": "^8.1",
        "webklex/php-imap": "^6.2",
        "zbateson/mail-mime-parser": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.69",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"exit(preg_match('/^APP_KEY=.+/m', file_get_contents('.env')) ? 0 : 1);\" || php artisan key:generate --ansi",
            "@php artisan share-register:hash-key --write --ansi",
            "@php artisan migrate --force --ansi",
            "npm install",
            "npm run build"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "lint": [
            "pint --test"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/mcp"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
