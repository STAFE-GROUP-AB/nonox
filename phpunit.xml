<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Tenancy">
            <directory>tests/Tenancy</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="nonox_test"/>
        <env name="NONOX_INBOX_MAILGUN_AUTHSERV_ID" value="mx.in.nonox.example"/>
        <env name="OTP_AUTOFILL" value="false"/>
        <env name="NONOX_MCP_ENABLED" value="true" force="true"/>
        <env name="PASSKEYS_SKIP_LOCALLY" value="false"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="NONOX_CHAT_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="NONOX_BANKING_DRIVER" value="" force="true"/>
        <env name="ENABLE_BANKING_APPLICATION_ID" value="" force="true"/>
        <env name="ENABLE_BANKING_PRIVATE_KEY_PATH" value="" force="true"/>
        <!-- Empty, so a developer's .env never points the tests at a taxonomy; set it on the command line to run the taxonomy checks (ADR-058). -->
        <env name="BOLAGSVERKET_TAXONOMY_DIR" value=""/>
        <env name="SKATTEVERKET_ENVIRONMENT" value="test" force="true"/>
        <env name="SKATTEVERKET_OAUTH_CLIENT_ID" value="" force="true"/>
        <env name="SKATTEVERKET_OAUTH_CLIENT_SECRET" value="" force="true"/>
        <env name="SKATTEVERKET_API_CLIENT_ID" value="" force="true"/>
        <env name="SKATTEVERKET_API_CLIENT_SECRET" value="" force="true"/>
        <env name="SKATTEVERKET_PILOT_USERS" value="" force="true"/>
    </php>
</phpunit>
