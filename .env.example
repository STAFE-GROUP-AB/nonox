APP_NAME="NONOX Ekonomisystem"

# Safe for a server as they stand. On your own computer, change three lines:
#   APP_ENV=local       the first-run guide and automatic sign-in codes only work locally
#   APP_DEBUG=true      shows error details in the browser; never on a server
#   OTP_AUTOFILL=true   fills in the sign-in code for you (needs APP_ENV=local and an
#                       APP_URL on localhost or *.test, so it can never work on a server)
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Stockholm
APP_URL=http://oss.test
APP_LOCALE=sv
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sv_SE

ADMIN_EMAIL=
OTP_AUTOFILL=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nonox
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Behind a proxy or CDN (e.g. Cloudflare with proxying on), list its address ranges,
# comma separated, so per-IP limits see the visitor and not the proxy. Empty: off.
# Never "*" on a server that can be reached without the proxy (config/trustedproxy.php).
# TRUSTED_PROXIES=

# API tokens (not issued yet): minutes until a token expires, and the prefix that
# lets secret scanners recognise a leaked token.
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=nonox_

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# "log" writes mails, sign-in codes included, to storage/logs/laravel.log: fine locally.
# A server needs real mail (smtp or mailgun), or no one can sign in.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@stafe.se"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"


# Skatteverket schema for arbetsgivardeklarationen (download from skatteverket.se)
SKATTEVERKET_AGI_SCHEMA_DIR=

# Public landing page at "/" (false: visitors see the sign-in page)
NONOX_LANDING_PAGE=true
NONOX_CONTACT_URL=
NONOX_TERMS_URL=
NONOX_PRIVACY_URL=
NONOX_COMPANY_NAME=
NONOX_COMPANY_ORG_NUMBER=

# Moving from Fortnox via their API (register an integration in Fortnox's developer portal,
# redirect URI: APP_URL/flytt/fortnox/klar)
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# The hosted service: new companies accept its terms and data processing agreement
NONOX_HOSTED=false
NONOX_PRIVACY_EMAIL=
NONOX_COMPANY_ADDRESS=

# NONOX Inbox (ADR-023)
NONOX_INBOX_DOMAIN=in.nonox.app
NONOX_INBOX_SHARED_LOCAL=mejl
NONOX_INBOX_CLAMD_SOCKET=
NONOX_INBOX_IMAP_ALLOW_PRIVATE=false
MAILGUN_WEBHOOK_SIGNING_KEY=
