APP_NAME="NONOX Ekonomisystem"

# Safe for a server as they stand. On your own computer, change four lines:
#   APP_ENV=local       the first-run guide and automatic sign-in codes only work locally
#   APP_DEBUG=true      shows error details in the browser; never on a server
#   SESSION_SECURE_COOKIE=false  only over plain http (http://*.test); a server always uses https
#   OTP_AUTOFILL=true   fills in the sign-in code for you (needs APP_ENV=local and an
#                       APP_URL on localhost or *.test, so it can never work on a server)
#   PASSKEYS_SKIP_LOCALLY=true  skips the passkey step at sign-in (same conditions; follows
#                       OTP_AUTOFILL when not set), since http://*.test is not a secure origin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://nonox.test
APP_LOCALE=sv
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sv_SE

ADMIN_EMAIL=
# Who may open /hq and decide on the waiting list (comma separated). Empty: ADMIN_EMAIL.
HQ_ADMINS=
OTP_AUTOFILL=false
# PASSKEYS_SKIP_LOCALLY=
# Passkeys are bound to APP_URL's host. Add origins (comma-separated) only if NONOX answers on more than one.
# PASSKEYS_ALLOWED_ORIGINS=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nonox
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# The session cookie is only sent over https, so it cannot leak on a plain http request.
SESSION_SECURE_COOKIE=true

# Behind a proxy or CDN (e.g. Cloudflare with proxying on), list its address ranges,
# comma separated, so per-IP limits see the visitor and not the proxy. Empty: off.
# Never "*" on a server that can be reached without the proxy (config/trustedproxy.php).
# TRUSTED_PROXIES=

# Sanctum API tokens are not accepted anywhere; the public API uses NONOX API (ADR-032).
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=nonox_

# NONOX API, the public API (ADR-032). OAuth signing keys: run
# "php artisan passport:keys" once (storage/oauth-*.key), or set them here.
# Changing the keys ends every access token.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# NONOX_CONNECT_ACCESS_TOKEN_MINUTES=15
# NONOX_CONNECT_REFRESH_TOKEN_DAYS=30
# NONOX_CONNECT_MAX_KEY_DAYS=365
# NONOX_MCP_ENABLED=false
# NONOX_CONNECT_RATE_LIMIT_PER_CREDENTIAL=120
# NONOX_CONNECT_RATE_LIMIT_PER_COMPANY=600
# NONOX_CONNECT_RATE_LIMIT_PER_IP=600
# NONOX_CONNECT_RATE_LIMIT_TOKEN_ENDPOINT=30
# NONOX_CONNECT_MCP_RATE_LIMIT_PER_CREDENTIAL=60
# SFTP for SIE files through SFTPGo (ADR-032, deploy/sftpgo/README.md).
# Off until the secret (at least 32 characters, e.g. "openssl rand -hex 32"),
# the host and the users' directory are set.
# NONOX_SFTPGO_HOOK_SECRET=
# NONOX_SFTPGO_HOOK_IPS=127.0.0.1
# NONOX_SFTP_HOST=sftp.example.se
# NONOX_SFTP_PORT=2022
# NONOX_SFTP_HOST_FINGERPRINTS=
# NONOX_SFTP_ROOT=/srv/sftpgo/users
# NONOX_SFTP_HOME_ROOT=

BROADCAST_CONNECTION=log
CACHE_STORE=file
# The encrypted chat (ADR-045) is never stored in the database: Redis when the
# phpredis extension is loaded and Redis is configured, otherwise files under
# storage/framework/cache/chat, emptied by `chat:prune`. Override with redis, file or array.
# NONOX_CHAT_STORE=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# "log" writes mails, sign-in codes included, to storage/logs/laravel.log: fine locally.
# A server needs real mail (smtp or mailgun), or no one can sign in.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@stafe.se"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"


# Skatteverket schema for arbetsgivardeklarationen (download from skatteverket.se)
SKATTEVERKET_AGI_SCHEMA_DIR=

# Bolagsverket's XBRL taxonomy for the iXBRL annual report (ADR-058): an unpacked package from
# https://xbrl.taxonomier.se/taxonomi-paket/taxonomi-paket-2026-08-31.zip (the folder that holds
# xbrl.taxonomier.se/). Never commit it. When set, every iXBRL file is checked against it.
# Easiest: run scripts/fetch-xbrl-taxonomy.sh (pinned version, SHA-256 verified, cached outside the repo)
# and paste the directory it prints. CI does this on every run.
BOLAGSVERKET_TAXONOMY_DIR=

# Skatteverket partner APIs (ADR-054): momsdeklaration, AGI, skattekonto, kundhändelser.
# Register an application with Skatteverket; redirect URI APP_URL/anslutningar/skatteverket/klar.
# test = Komplett testtjänst, production needs a signed agreement. Empty keys = not offered.
# Skatteverket's terms: personal data from these APIs may only be received in the EU/EEA,
# so the installation must run in a data centre there.
SKATTEVERKET_ENVIRONMENT=test
SKATTEVERKET_OAUTH_CLIENT_ID=
SKATTEVERKET_OAUTH_CLIENT_SECRET=
SKATTEVERKET_API_CLIENT_ID=
SKATTEVERKET_API_CLIENT_SECRET=
# Comma-separated e-mail addresses: when set, only they see the integration
# (for trying the test service on a live installation).
SKATTEVERKET_PILOT_USERS=

# Public landing page at "/" (false: visitors see the sign-in page)
NONOX_LANDING_PAGE=true
# The user manual at /manual (shown with the landing page); empty: docs/manual/sv
NONOX_MANUAL_PATH=
NONOX_CONTACT_URL=
NONOX_TERMS_URL=
NONOX_PRIVACY_URL=
NONOX_COMPANY_NAME=
NONOX_COMPANY_ORG_NUMBER=

# Moving from Fortnox via their API (register an integration in Fortnox's developer portal,
# redirect URI: APP_URL/flytt/fortnox/klar)
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# The hosted service: new companies accept its terms and data processing agreement
NONOX_HOSTED=false
NONOX_PRIVACY_EMAIL=
# Where security reports go (shown on /sakerhet, in the security policy and in /.well-known/security.txt);
# falls back to NONOX_PRIVACY_EMAIL. An address set in /hq -> Installningar wins over both (ADR-078).
NONOX_SECURITY_EMAIL=
# The public security policy page (/sakerhetspolicy) and the Policy line of security.txt. Off by default;
# the hosted service turns it on after legal review (ADR-078). A self-hosted installation also needs NONOX_COMPANY_NAME.
NONOX_SECURITY_POLICY_PUBLISHED=false
NONOX_COMPANY_ADDRESS=

# NONOX Inbox (ADR-023)
NONOX_INBOX_DOMAIN=in.nonox.app
NONOX_INBOX_SHARED_LOCAL=mejl
NONOX_INBOX_CLAMD_SOCKET=
NONOX_INBOX_IMAP_ALLOW_PRIVATE=false
MAILGUN_WEBHOOK_SIGNING_KEY=

# Kassakopplingar (ADR-042): each installation registers its own app with the till provider.
# Zettle: developer.zettle.com, partner-hosted app, redirect URL APP_URL/anslutningar/kassa/zettle/klar.
# Onslip 360: an Integration in Onslip, redirect URL APP_URL/anslutningar/kassa/onslip/klar
# (ONSLIP_ENVIRONMENT=test for the sandbox). Empty = the till is shown as not configured.
ZETTLE_CLIENT_ID=
ZETTLE_CLIENT_SECRET=
ZETTLE_CONTACT_EMAIL=
ONSLIP_CLIENT_ID=
ONSLIP_ENVIRONMENT=prod

# NONOX Banking (ADR-034): open banking through Enable Banking. Empty driver = fake bank locally,
# Enable Banking elsewhere. Redirect URL to register with Enable Banking: APP_URL/bank/klar
# The private key (.pem) stays outside the repository.
NONOX_BANKING_DRIVER=
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
# Kill switch: true pauses the bank feed at once (keys stay), or a list such as enable_banking.
NONOX_BANKING_PAUSED=

# Peppol e-faktura (ADR-050): an access point the operator has an agreement with.
# Empty driver = log driver locally (nothing leaves), no access point elsewhere.
# qvalia: Partner API, sandbox URL by default; production https://api.qvalia.com.
# peppol:link subscribes APP_URL/webhooks/peppol/qvalia per company and stores its secret;
# QVALIA_WEBHOOK_SECRET is only for a subscription made by hand.
NONOX_PEPPOL_DRIVER=
QVALIA_API_URL=
QVALIA_PARTNER_REG_NO=
QVALIA_API_KEY=
QVALIA_WEBHOOK_SECRET=
# Kill switch: true pauses Peppol at once (keys stay), or a list such as qvalia.
NONOX_PEPPOL_PAUSED=

# Company lookup (ADR-035): fill in name, address and legal form from an organisation number.
# Empty driver = invented demo register locally, no lookup elsewhere. For Bolagsverket's free
# "API för värdefulla datamängder", register at Bolagsverket and set the driver to bolagsverket.
# BOLAGSVERKET_ENVIRONMENT=test uses their accept2 test environment. Never commit the secret.
# COMPANY_REGISTRY_DRIVER=bolagsverket
# BOLAGSVERKET_CLIENT_ID=
# BOLAGSVERKET_CLIENT_SECRET=
# BOLAGSVERKET_ENVIRONMENT=prod
# The company register for prospecting in the CRM (ADR-047). COMPANY_REGISTER_IMPORT=true loads
# SCB's and Bolagsverket's free weekly bulk files every Monday (about 1.2 million legal persons).
# SCB_AFR_API_KEY (free, personal, from registreraafr.scb.se) adds size classes, municipality,
# county, phone and opt-outs. Never commit the key.
# COMPANY_REGISTER_IMPORT=false
# SCB_AFR_API_KEY=
# CREDIT_DATA_DRIVER=

# CRM (ADR-043): key for the suppression list of people who objected to being contacted
# (HMAC of e-mail and phone, pseudonymised). Leave empty to derive it from APP_KEY.
# Keep it when rotating APP_KEY; old hashes also match under APP_PREVIOUS_KEYS.
NONOX_CRM_SUPPRESSION_KEY=

# Aktiebok och styrelserum (ADR-070): key for the share register's hash chain, which hashes
# personal numbers as HMAC-SHA256 instead of in clear text. Separate from APP_KEY. Created once by
# `php artisan share-register:hash-key --write` (run by `composer setup`). Never change it: a new
# key breaks the chain of every company's register. Keep it in the backup with APP_KEY.
NONOX_REGISTER_HASH_KEY=

# CRM calendar sync with Google and Microsoft (ADR-049). Off until set; see the ADR for the app
# registrations. Redirect URIs default to APP_URL/kunder/kalender/koppla/{google|microsoft}/svar.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_TENANT=organizations

# CRM mailings (ADR-048): messages per company per hour and per day.
NONOX_CRM_MAILING_HOURLY_CAP=500
NONOX_CRM_MAILING_DAILY_CAP=2000
# CRM mail's own sending domain (ADR-048). Hosted: required for mailings and template mail.
# Self-hosted: leave empty to use the default mailer.
NONOX_CRM_MAILER=
NONOX_CRM_MAIL_FROM=
NONOX_CRM_SMTP_HOST=
NONOX_CRM_SMTP_PORT=587
NONOX_CRM_SMTP_USERNAME=
NONOX_CRM_SMTP_PASSWORD=
NONOX_CRM_SMTP_SCHEME=

# The customer portal (ADR-075) can be turned on only when this is true, after the legal review in
# docs/juridik/kundportal-utkast.md, and only with a queue that runs in the background (not sync).
# NONOX_CUSTOMER_PORTAL=false
